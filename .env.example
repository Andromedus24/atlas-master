# Atlas AI Desktop Assistant Configuration

# Environment
NODE_ENV=development

# AI Provider Configuration (choose one provider)
# Anthropic Claude (recommended)
ATLAS_AI_PROVIDER=anthropic
ATLAS_AI_API_KEY=your-anthropic-api-key-here
ATLAS_AI_MODEL=claude-3-5-sonnet-20241022

# OpenAI GPT (alternative)
# ATLAS_AI_PROVIDER=openai
# ATLAS_AI_API_KEY=your-openai-api-key-here
# ATLAS_AI_MODEL=gpt-4

# Google Gemini (alternative)
# ATLAS_AI_PROVIDER=google
# ATLAS_AI_API_KEY=your-gemini-api-key-here
# ATLAS_AI_MODEL=gemini-pro

# Ollama (local, for offline mode)
# ATLAS_AI_PROVIDER=ollama
# ATLAS_AI_BASE_URL=http://localhost:11434
# ATLAS_AI_MODEL=llama2

# Dashboard Configuration
ATLAS_DASHBOARD_PORT=3000
ATLAS_DASHBOARD_THEME=system
ATLAS_DASHBOARD_AUTO_START=false

# Plugin Configuration
ATLAS_PLUGINS_ENABLED=vision-service,automation-service
ATLAS_TRUSTED_PATHS=/path/to/trusted/plugins,/another/trusted/path

# Security Configuration
ATLAS_ENABLE_AUDIT_LOG=true
ATLAS_PERMISSION_REQUIRE_APPROVAL=automation,filesystem
ATLAS_ALLOWED_DOMAINS=github.com,stackoverflow.com

# Storage Configuration
ATLAS_DATA_PATH=./.atlas/data
ATLAS_MAX_STORAGE_SIZE=1073741824
ATLAS_RETENTION_DAYS=30

# Performance Configuration
ATLAS_MAX_JOB_HISTORY=10000
ATLAS_CACHE_SIZE=104857600

# Debug Configuration
DEBUG=atlas:*
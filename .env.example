# Atlas (free-cluely) Environment Configuration

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================

# Primary AI Provider (Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional AI Providers
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Default AI Provider (anthropic, google, ollama)
DEFAULT_AI_PROVIDER=anthropic

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Development
NODE_ENV=development
PORT=3000

# Dashboard Configuration
NEXT_PUBLIC_APP_NAME=Atlas
NEXT_PUBLIC_APP_VERSION=0.1.0

# Electron Configuration
ELECTRON_DISABLE_SECURITY_WARNINGS=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# SQLite Database Path (relative to electron-host)
DATABASE_PATH=./data/atlas.db

# =============================================================================
# SECURITY & PERMISSIONS
# =============================================================================

# Permission Settings
PERMISSION_AUTO_PROMPT=true
SCREEN_CAPTURE_ALLOWED=true
CLIPBOARD_ACCESS_ALLOWED=true
AUTOMATION_ALLOWED=true
NETWORK_ACCESS_ALLOWED=true

# Domain Allowlist for Automation (comma-separated)
AUTOMATION_ALLOWLIST=localhost,github.com,stackoverflow.com

# =============================================================================
# PLUGIN SYSTEM
# =============================================================================

# Plugin Directories (comma-separated)
PLUGIN_PATHS=./plugins,./packages/*/plugins

# Plugin Security
PLUGIN_ISOLATION_ENABLED=true
PLUGIN_TIMEOUT_MS=30000

# =============================================================================
# LOGGING & DEBUGGING
# =============================================================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Enable Debug Mode
DEBUG=false

# =============================================================================
# PERFORMANCE & CACHING
# =============================================================================

# Cache Settings
CACHE_TTL_MS=3600000
MAX_CACHE_SIZE_MB=100

# Performance Monitoring
ENABLE_METRICS=false
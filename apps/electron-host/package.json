{
  "name": "@free-cluely/electron-host",
  "version": "1.0.0",
  "description": "Electron host application for Atlas",
  "main": "dist/main.js",
  "homepage": "./",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "concurrently \"tsc --watch\" \"vite build --watch\"",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist node_modules",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@free-cluely/shared": "workspace:*",
    "@free-cluely/config": "workspace:*",
    "@free-cluely/plugin-bus": "workspace:*",
    "electron": "^33.0.0",
    "socket.io": "^4.7.0",
    "better-sqlite3": "^9.0.0",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "concurrently": "^8.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.free-cluely.atlas",
    "productName": "Atlas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    }
  }
}